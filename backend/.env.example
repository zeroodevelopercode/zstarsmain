# Set these values only in the backend host's secret/environment settings.
APP_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
OTP_PEPPER=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=SET_DIRECTLY_IN_HOSTING_DASHBOARD
GMAIL_REFRESH_TOKEN=SET_DIRECTLY_IN_HOSTING_DASHBOARD
